{
  "name": "makers-bazar-front",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "npm --workspace @marketplace/web run dev",
    "build": "npm --workspace @marketplace/web run build",
    "start": "npm --workspace @marketplace/web run start",
    "typecheck": "npm --workspace @marketplace/web run typecheck",
    "verify:checkout-recovery": "npm --workspace @marketplace/web run verify:checkout-recovery"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.8.2"
  }
}
