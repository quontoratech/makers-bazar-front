# Public storefront name
NEXT_PUBLIC_SITE_NAME=The Makers Bazar

# Public URLs of the separately deployed Vendure backend
NEXT_PUBLIC_VENDURE_SHOP_API_URL=https://api.example.com/shop-api
NEXT_PUBLIC_VENDURE_ADMIN_API_URL=https://api.example.com/admin-api
NEXT_PUBLIC_CHAT_SOCKET_URL=https://api.example.com

# Leave empty to use Vendure's default channel
NEXT_PUBLIC_DEFAULT_CHANNEL_TOKEN=

# Use a long, random value in production. Never commit the real value.
COOKIE_SECRET=replace-with-a-long-random-production-secret

# Private server-side storage used by authenticated digital downloads
PRIVATE_DIGITAL_ASSET_DIR=/absolute/private/path/digital-assets
